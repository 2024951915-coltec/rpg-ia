<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
    <head>
        <title>Boulderspire RPG &ndash; Nova campanha</title>
        <%- include('libs/bootstrap') %>
        <%- include('libs/jquery') %>

        <!--Com esse include vc vai poder usar os atributos clickable e redir-->
        <!--Eles basicamente fazem qualquer elemento ser clicável e redirecionar para uma página-->
        <%- include('include/browser-elements.ejs') %>
    </head>

    <body class="bg-secondary">
        <%- include('partials/header') %>

        <main class="container-md mt-5">
            <div class="d-flex flex-row justify-content-center">
                <div class="card">
                    <div class="card-header">
                        <h1 class="card-title">
                            Nova Campanha
                        </h1>
                    </div>

                    <div class="card-body">
                        <p class="card-text">Crie uma campanha e hospede-a em uma sala</p>

                        <form method="POST" action="#">
                            <div class="mb-3">
                                <label for="name" class="form-label">
                                    Nome da Campanha
                                </label>
                                <input
                                    name="name" 
                                    id="name" 
                                    type="text" 
                                    class="form-control"
                                    monospace
                                >
                            </div>

                            <div class="mb-3">
                                <label for="name" class="form-label">
                                    Descreva sua campanha
                                </label>
                                <textarea
                                    name="desc" 
                                    id="desc" 
                                    class="form-control"
                                    monospace
                                ></textarea>
                            </div>

                            <input class="btn btn-outline-success" type="submit" value="Criar">
                        </form>
                    </div>
                </div>
            </div>
        </main>

        <%- include('partials/footer') %>
    </body>
</html>